# /etc/nginx/sites-available/jxlconverter
# Local-only site for Cloudflare Tunnel: no domain, no certbot needed.
# Cloudflare handles the public hostname and HTTPS.
#
# Replace <user>, then:
#   sudo ln -s /etc/nginx/sites-available/jxlconverter /etc/nginx/sites-enabled/
#   sudo chmod o+x /home/<user>          # let nginx traverse the home dir
#   sudo nginx -t && sudo systemctl reload nginx
#   curl -I http://127.0.0.1:8080/      # should return 200
#
# Then in Cloudflare Zero Trust → Networks → Tunnels → your tunnel → Public Hostname:
#   hostname: jxl.yourdomain.com   service: HTTP   URL: localhost:8080
# (or in config.yml ingress:  - hostname: jxl.yourdomain.com
#                               service: http://localhost:8080)

server {
    # Only reachable from the server itself; the tunnel connects locally.
    listen 127.0.0.1:8080;
    server_name _;

    root /home/<user>/jxlconverter;
    index index.html;

    # WebAssembly must be served as application/wasm for streaming compile.
    include mime.types;
    types {
        application/wasm wasm;
        image/jxl        jxl;
    }

    gzip on;
    gzip_types text/css application/javascript application/wasm image/svg+xml;
    gzip_min_length 1024;

    # Vite fingerprints asset filenames, so they can be cached forever.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Always revalidate the HTML so new deploys show up immediately.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
